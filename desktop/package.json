{
  "name": "mason-desktop",
  "productName": "Mason",
  "version": "0.1.3",
  "private": true,
  "description": "Mason for desktop \u2014 sketches in, interfaces out.",
  "main": "main.js",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "dev": "env -u ELECTRON_RUN_AS_NODE MASON_URL=http://localhost:3000 electron .",
    "smoke": "env -u ELECTRON_RUN_AS_NODE ELECTRON_SMOKE=1 electron .",
    "dist": "electron-builder --mac --config electron-builder.config.mjs",
    "bundle": "node bundle.mjs",
    "smoke:dist": "env -u ELECTRON_RUN_AS_NODE ELECTRON_SMOKE=1 ./release/mac-arm64/Mason.app/Contents/MacOS/Mason",
    "publish:webapp": "node publish-webapp.mjs"
  },
  "devDependencies": {
    "electron": "^38.2.1",
    "electron-builder": "^26.0.12"
  },
  "type": "module"
}
