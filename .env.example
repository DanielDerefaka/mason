# ---------------------------------------------------------------------------
# Mason — environment
#
# Copy to .env.local and fill in. Both .env and .env.local are gitignored;
# this file carries names and shapes only, never a real value.
#
# Split by where the variable is read: Next reads .env.local, Convex functions
# read the deployment's own environment (`npx convex env set NAME value`).
# Setting a Convex variable here has no effect.
# ---------------------------------------------------------------------------


# ── Convex — read by Next ───────────────────────────────────────────────────
# Both are written by `npx convex dev` on first run. CONVEX_DEPLOYMENT is what
# the CLI targets; NEXT_PUBLIC_CONVEX_URL is what the browser client connects
# to.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# The Convex HTTP endpoint, used for auth callbacks. Same host as the URL
# above with `.cloud` swapped for `.site`.
NEXT_PUBLIC_CONVEX_SITE_URL=


# ── Anthropic — read by the generation routes ───────────────────────────────
# Required. Style guides, designs, flows, revisions and the editor's per-element
# AI all fail without it.
ANTHROPIC_API_KEY=

# Optional, for a gateway rather than api.anthropic.com. `/v1` is appended, so
# give the origin only.
ANTHROPIC_BASE_URL=

# Optional. Some gateways reject a request without a recognised client
# User-Agent. Setting this makes requests claim to come from a client they did
# not — check the terms of whatever you are pointing at before using it.
ANTHROPIC_CLIENT_UA=

# Optional overrides. MODEL is used for extraction (style guides, flow plans);
# UI_MODEL for writing designs. Both default to claude-opus-5.
ANTHROPIC_MODEL=
ANTHROPIC_UI_MODEL=


# ── Email — read by Convex, set with `npx convex env set` ───────────────────
# Optional. Password reset and address verification only attach when
# AUTH_RESEND_KEY is present; without it the app still signs people in and out,
# and `npx convex run auth:setPassword` is the way back into an account.
AUTH_RESEND_KEY=

# Optional. The From address on those emails. Defaults to Resend's shared
# onboarding sender, which is fine for testing and not for real users.
AUTH_EMAIL_FROM=


# ── Auth — set automatically ────────────────────────────────────────────────
# `npx @convex-dev/auth` writes JWKS, JWT_PRIVATE_KEY and SITE_URL into the
# Convex deployment. They are listed here so their absence is not a mystery;
# do not set them by hand.
