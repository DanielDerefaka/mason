# =============================================================================
# Sketch to Design — environment
# =============================================================================
# Copy to .env.local and fill in. .env.local is gitignored; never commit real
# keys.
#
#   cp .env.example .env.local
#
# READ THIS FIRST — there are TWO places variables live:
#
#   1. .env.local        read by Next.js (the browser and the app server)
#   2. Convex deployment read by code inside convex/*.ts
#
# A key pasted into .env.local is INVISIBLE to Convex functions. Anything used
# inside a Convex query, mutation or action must be set on the deployment:
#
#   npx convex env set NAME "value"
#   npx convex env list
#
# Each block below says which of the two it belongs to.
# =============================================================================


# -----------------------------------------------------------------------------
# Convex — ALREADY DONE, nothing to do here
# -----------------------------------------------------------------------------
# Written automatically by `npx convex dev`. Listed only so you know what they
# are; do not hand-edit them.
#
#   CONVEX_DEPLOYMENT
#   NEXT_PUBLIC_CONVEX_URL
#   NEXT_PUBLIC_CONVEX_SITE_URL
#
# And on the deployment, written by the Convex Auth setup:
#   SITE_URL, JWT_PRIVATE_KEY, JWKS


# -----------------------------------------------------------------------------
# Google sign-in — OPTIONAL  (goes on the CONVEX DEPLOYMENT, not here)
# -----------------------------------------------------------------------------
# The Google and Microsoft buttons on /auth/sign-in are inert until this is set.
# Email + password auth already works without it.
#
# Get them: https://console.cloud.google.com/apis/credentials
#   → Create Credentials → OAuth client ID → Web application
#   → Authorised JavaScript origin:  https://<your-ngrok-subdomain>.ngrok-free.dev
#   → Authorised redirect URI:       <NEXT_PUBLIC_CONVEX_SITE_URL>/api/auth/callback/google
#
# Google will not call http://localhost, which is why the ngrok tunnel matters.
#
#   npx convex env set AUTH_GOOGLE_ID     "…apps.googleusercontent.com"
#   npx convex env set AUTH_GOOGLE_SECRET "GOCSPX-…"
#
# If you point SITE_URL at the tunnel for OAuth testing, remember to set it back
# to http://localhost:3000 afterwards or local sign-in breaks:
#   npx convex env set SITE_URL "http://localhost:3000"


# -----------------------------------------------------------------------------
# Anthropic — REQUIRED for chapters 26–30 (the AI features)
# -----------------------------------------------------------------------------
# This is the one that unblocks the most: generative AI, streaming responses,
# inspiration images and the design workflows. Five of the six remaining
# chapters need it.
#
# Get it: https://console.anthropic.com/settings/keys
#
# Set it in BOTH places if the model is called from Convex actions as well as
# from a Next.js route handler. Start with the deployment:
#
#   npx convex env set ANTHROPIC_API_KEY "sk-ant-…"
#
ANTHROPIC_API_KEY=

# Optional pin. Leave unset and the app uses claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5

# --- Routing through a gateway instead of Anthropic directly ----------------
# Both are optional. Unset, the SDK talks to api.anthropic.com and sends its own
# User-Agent, which is what you want with a console.anthropic.com key.
#
#   ANTHROPIC_BASE_URL=https://agentrouter.org
#
# agentrouter.org also refuses any request whose User-Agent is not Claude
# Code's, answering 401 `unauthorized_client_error` — a valid key on its own is
# not enough. Setting the variable below makes this app claim to be Claude Code,
# which it is not. Understand that before relying on it: the claim is untrue, it
# breaks whenever they tighten the check, and a gateway that serves only
# Claude-Code-shaped traffic may be reselling subscription access on terms its
# upstream does not allow. Leave unset unless you have decided that is fine.
#
#   ANTHROPIC_CLIENT_UA="claude-cli/2.1.221 (external, cli)"


# -----------------------------------------------------------------------------
# Inngest — REQUIRED for background jobs (chapter 23's queue path, 30)
# -----------------------------------------------------------------------------
# Autosave already persists to Convex without this. Inngest is what moves the
# long-running AI generation off the request.
#
# Get them: https://app.inngest.com → Manage → Event Keys / Signing Key
#
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=


# -----------------------------------------------------------------------------
# Polar — REQUIRED for billing (chapter 24)
# -----------------------------------------------------------------------------
# Until this is set, the entitlement check in src/convex/query.config.ts stays
# hardcoded to `entitled: true` and everyone gets through.
#
# Get them: https://polar.sh → Settings → Developers → New Token
# Use the sandbox while developing: https://sandbox.polar.sh
#
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_ORGANIZATION_ID=

# 'sandbox' while testing, 'production' when you go live.
POLAR_SERVER=sandbox

# The product/price you sell. From the Polar dashboard after creating a product.
POLAR_PRODUCT_ID=

# Where Polar sends the customer back after checkout.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# ngrok — DEV ONLY, no key needed in this file
# -----------------------------------------------------------------------------
# Needed so Google OAuth and any webhook (Polar, Inngest) can reach your
# machine. Run it alongside the dev server:
#
#   ngrok http 3000
#
# Then use the https URL it prints as the callback/webhook base.


# -----------------------------------------------------------------------------
# Sevalla — deployment only, nothing goes in this file
# -----------------------------------------------------------------------------
# Chapters 3 and 33. Connect the GitHub repo in the Sevalla dashboard and set
# these same variables there as the production environment.
