# ---------------------------------------------------------------------------
# Mason — environment
#
# Copy to .env.local and fill in. Both .env and .env.local are gitignored;
# this file carries names and shapes only, never a real value.
#
# Split by where the variable is read: Next reads .env.local, Convex functions
# read the deployment's own environment (`npx convex env set NAME value`).
# Setting a Convex variable here has no effect.
# ---------------------------------------------------------------------------


# ── Convex — read by Next ───────────────────────────────────────────────────
# Both are written by `npx convex dev` on first run. CONVEX_DEPLOYMENT is what
# the CLI targets; NEXT_PUBLIC_CONVEX_URL is what the browser client connects
# to.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# On Vercel these two are NOT set by hand. `convex deploy` writes them during
# the build from CONVEX_DEPLOY_KEY. Copying the local values across is the
# commonest deploy mistake — it points production at the dev backend.


# ── Anthropic — read by the generation routes ───────────────────────────────
# Required. Style guides, designs, flows, revisions and the editor's per-element
# AI all fail without it.
ANTHROPIC_API_KEY=

# Optional, for a gateway rather than api.anthropic.com. `/v1` is appended, so
# give the origin only.
ANTHROPIC_BASE_URL=

# Optional. Some gateways reject a request without a recognised client
# User-Agent. Setting this makes requests claim to come from a client they did
# not — check the terms of whatever you are pointing at before using it.
ANTHROPIC_CLIENT_UA=

# Optional, and only for identity-linked keys — the kind made against your
# Anthropic account rather than inside a workspace. Those refuse every request
# with 400 "anthropic-workspace-id is required"; this is the `wrkspc_…` id from
# the Console URL. A key made inside a workspace needs nothing here.
ANTHROPIC_WORKSPACE_ID=

# Optional overrides. MODEL is used for extraction (style guides, flow plans);
# UI_MODEL for writing designs. Both default to claude-opus-5.
ANTHROPIC_MODEL=
ANTHROPIC_UI_MODEL=


# ── Email — read by Convex, set with `npx convex env set` ───────────────────
# Optional. Password reset and address verification only attach when
# AUTH_RESEND_KEY is present; without it the app still signs people in and out,
# and `npx convex run auth:setPassword` is the way back into an account.
AUTH_RESEND_KEY=

# Optional. The From address on those emails. Defaults to Resend's shared
# onboarding sender, which is fine for testing and not for real users.
AUTH_EMAIL_FROM=


# ── Billing — Polar, the merchant of record ─────────────────────────────────
# Optional. Without these the billing page says billing is not configured and
# everything else keeps working.
#
# Polar charges the card and remits VAT and sales tax, so this app never sees
# card details — only a signed webhook. That also means a Stripe merchant
# account is not needed in countries Stripe does not serve.
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=

# "sandbox" while testing, "production" for real cards. They are separate
# worlds; a sandbox token against production returns 401.
POLAR_SERVER=sandbox

# The signing secret from the webhook you create in Polar, pointed at
# /api/polar/webhook.
#
# This one goes in TWO places — here, and on the Convex deployment
# (`npx convex env set POLAR_WEBHOOK_SECRET ...`). The route verifies Polar's
# signature with it; Convex uses it to reject anything that did not come from
# the route.
POLAR_WEBHOOK_SECRET=

# Set to "true" to require a subscription. Left unset, the real status is still
# computed and shown on /billing, but nobody is redirected — so turning billing
# on does not lock out accounts that predate it.
BILLING_ENFORCED=


# ── Auth — set automatically ────────────────────────────────────────────────
# `npx @convex-dev/auth` writes JWKS, JWT_PRIVATE_KEY and SITE_URL into the
# Convex deployment. They are listed here so their absence is not a mystery;
# do not set them by hand.


# ── Photography — read by /api/image ────────────────────────────────────────
# Optional, free, and the single cheapest thing here for how a design looks.
# Every photographic slot in a generated design resolves through it.
#
# Without it image slots fall back to a neutral grey panel — the design is
# still correct, it just has no photographs in it.
#
# https://www.pexels.com/api/
PEXELS_API_KEY=


# ── The site's own URL ──────────────────────────────────────────────────────
# Optional. Used to build Polar's checkout return URL and as the base for
# Open Graph image URLs on share links (a crawler needs an absolute URL).
# Without it the app falls back to the deployed domain for share cards and to
# the request's own origin for Polar. Set it if the app sits behind a proxy
# that rewrites the origin.
NEXT_PUBLIC_APP_URL=


# ── The free week — /try ────────────────────────────────────────────────────
# Set to "true" to redirect the /auth/* screens to /try, so nobody is offered
# an account during the week. That is now its only job: it does *not* gate the
# landing page (it did, and that took / off the internet), and it does not
# decide where a call to action points — /try is public either way. Read on
# the server only; never make this NEXT_PUBLIC.
FREE_WEEK=

# Required in production for guest sessions. Signs the admission token that
# lets a visitor open an anonymous session, and keys the hash that stands in
# for their IP — so it goes in TWO places: here (the /api/try/admit route
# signs with it) and on the Convex deployment (the anonymous provider verifies
# with it): `npx convex env set GUEST_ADMISSION_SECRET ...`. Generate with
# `openssl rand -hex 32`. Unset, guest sign-in is accepted without a token,
# which is fine locally and not in production.
GUEST_ADMISSION_SECRET=

# Convex only. How many free generations all guests share per UTC day.
# Defaults to 20.
COMMUNITY_POOL_SIZE=

# Convex only. How many new guest sessions one network may open in a UTC day.
# Defaults to 10. Set it live while the week is running — `npx convex env set
# GUEST_SESSIONS_PER_IP_PER_DAY 40` needs no deploy — because the cap counts a
# network, and one office or campus NAT can reach ten with ten legitimate
# visitors.
#
# For both of these: leaving the variable blank means "unset", not zero. A
# real 0 is honoured, and shuts the thing off.
GUEST_SESSIONS_PER_IP_PER_DAY=


# ── Error reporting — Sentry ────────────────────────────────────────────────
# All optional. Without a DSN the SDK is inert and the app behaves exactly as
# it did before, so a clone of this repository needs none of it.
#
# The DSN is public by design — it identifies the project to send to and grants
# nothing.
NEXT_PUBLIC_SENTRY_DSN=

# Optional. Website-specific DataFast Bot traffic token (dfbot_…). The public
# website id is already in src/lib/datafast.ts. Unset, tracking still works
# until the Bot traffic card is set to reject unauthenticated requests.
DATAFAST_BOT_TOKEN=

# ── Analytics — PostHog ─────────────────────────────────────────────────────
# Optional. Without a project key PostHog never initialises, and DataFast
# still records page views. Create a project
# at posthog.com, paste the project API key, and set the host to
# https://us.i.posthog.com or https://eu.i.posthog.com.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Optional. Google Search Console HTML-tag verification. Paste the content
# value only, not the whole meta tag. Unset, the tag is omitted.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Only needed to upload source maps at build time, which is what turns a
# minified production stack trace into a readable one. All three must be set or
# the upload step is skipped entirely rather than failing the build.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
